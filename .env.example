# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=cdc_verify_token_secret

# Meta Graph API (Facebook Page + Instagram)
META_PAGE_ACCESS_TOKEN=your_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# Fireworks AI (Gemma, hosted on AMD hardware)
FIREWORKS_API_KEY=your_fireworks_api_key
FIREWORKS_MODEL=accounts/fireworks/models/gemma-3-27b-it

# Owner WhatsApp number (with country code, no + prefix)
OWNER_WHATSAPP=13365550001

# Port for the webhook server
PORT=8080
